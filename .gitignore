.DS_Store

.eslintcache
node_modules/

.env
.env.local
.env.production

*.log

.turbo/

tsconfig.tsbuildinfo
*.tsbuildinfo

# Build output
dist/

.vscode

# Local-only agent + workspace settings
.claude/settings.local.json
.humanlayer/workspace.local.json

# Riptide artifacts (cloud-synced)
.humanlayer/tasks/

# Ephemeral local scratch space (handoffs, local-only notes)
.scratch/

# Two locations, one rule: the harness owns .claude/worktrees/ (auto-created
# for dispatched-isolated agents — Claude Code hard-gates entering a worktree
# outside it, so placement here is what avoids the prompt, not a file-tool
# restriction), humans and the CLI own .worktrees/ (see
# .agents/skills/implement and apps/cli/src/worktree.ts).
.worktrees/
.claude/worktrees/

# Local telemetry JSONL (see packages/observability; clean with `pnpm telemetry:clean`)
var/telemetry/
